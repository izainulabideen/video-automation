# ============================================================
# VEANK STUDIO — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# Dashboard → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# APP URL
# Use http://localhost:3000 for local dev.
# Set to your production domain when deployed (no trailing slash).
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# SESSION SECRET
# Used to sign HMAC-SHA256 session cookies.
# Must be at least 32 random characters.
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------
SESSION_SECRET=replace_with_64_hex_chars_from_openssl_rand_hex_32

# ------------------------------------------------------------
# ANTHROPIC API KEY  (Phase 2 — AI Generation)
# Get from: https://console.anthropic.com/settings/keys
# Required for: AI script generation, hook variants, prompt generation
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# ------------------------------------------------------------
# SMTP — Email (invites, password resets)
# Gmail: enable 2FA → create an App Password (not your main password)
# Other providers: Resend, Postmark, SendGrid all work fine.
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# For Resend (alternative to Gmail):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# NOTES
# ------------------------------------------------------------
# Supabase Storage bucket name must be: storage
# All migrations are in supabase/migrations/ — run them in order
# in the Supabase SQL Editor (Dashboard → SQL Editor → New query).
#
# Migrations to run:
#   001_initial_schema.sql
#   002_users.sql
#   003_graphics_media_type.sql
#   004_scenarios_is_public.sql
#   005_public_settings.sql
#   006_phase1_checklist_activity.sql
#   007_phase3_collaboration.sql
#   008_script_versions.sql
